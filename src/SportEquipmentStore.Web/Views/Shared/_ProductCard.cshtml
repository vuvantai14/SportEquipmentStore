@model ProductCardViewModel

@{
    var imageUrl = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? Url.Content("~/images/placeholders/product-placeholder.svg")
        : Model.ImageUrl;
}

<article class="product-card">
    <div class="product-card__media">
        <img src="@imageUrl" alt="@Model.ProductName" loading="lazy" />
        <span class="product-card__stock @(Model.StockQuantity > 0 ? "is-available" : "is-unavailable")">
            @(Model.StockQuantity > 0 ? "Còn hàng" : "Hết hàng")
        </span>
    </div>
    <div class="product-card__body">
        <span class="product-card__category">@Model.CategoryName</span>
        <h3 class="product-card__title">@Model.ProductName</h3>
        <strong class="product-card__price">@Model.Price.ToString("N0") ₫</strong>
        @if (!string.IsNullOrWhiteSpace(Model.DetailUrl))
        {
            <a class="btn btn-outline-primary product-card__action" href="@Model.DetailUrl">Xem chi tiết</a>
        }
        else
        {
            <span class="btn btn-outline-primary product-card__action disabled" aria-disabled="true">Xem chi tiết</span>
        }
    </div>
</article>
