@model IReadOnlyList<SportEquipmentStore.Core.Entities.Category>

<button class="nav-link dropdown-toggle"
        type="button"
        data-bs-toggle="dropdown"
        aria-expanded="false">
    Danh mục
</button>
<ul class="dropdown-menu category-menu">
    @if (Model.Count == 0)
    {
        <li><span class="dropdown-item-text text-muted">Chưa có danh mục hoạt động</span></li>
    }
    else
    {
        @foreach (var category in Model)
        {
            <li>
                <a class="dropdown-item category-menu__item"
                   asp-controller="Product"
                   asp-action="Index"
                   asp-route-categoryId="@category.CategoryId">
                    <span>@category.CategoryName</span>
                </a>
            </li>
        }
    }
</ul>
