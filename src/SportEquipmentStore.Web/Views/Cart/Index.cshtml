@using System.Globalization
@model CartViewModel

@{
    ViewData["Title"] = "Giỏ hàng";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/cart.css" asp-append-version="true" />
}

<header class="cart-heading">
    <div>
        <span class="cart-heading__eyebrow">Giỏ hàng của bạn</span>
        <h1>Giỏ hàng</h1>
    </div>
    @if (Model.Items.Count > 0)
    {
        <span class="cart-heading__count">@Model.TotalItems sản phẩm</span>
    }
</header>

@if (TempData["CartSuccess"] is string successMessage)
{
    <div class="cart-alert cart-alert--success" role="status">@successMessage</div>
}

@if (TempData["CartError"] is string errorMessage)
{
    <div class="cart-alert cart-alert--error" role="alert">@errorMessage</div>
}

@if (Model.Items.Count == 0)
{
    <section class="cart-empty" aria-labelledby="empty-cart-title">
        <span class="cart-empty__icon">@await Html.PartialAsync("_Icon", "cart")</span>
        <h2 id="empty-cart-title">Giỏ hàng của bạn đang trống.</h2>
        <p>Khám phá các sản phẩm thể thao và thêm lựa chọn phù hợp vào giỏ hàng.</p>
        <a class="btn btn-primary" asp-controller="Product" asp-action="Index">Tiếp tục mua sắm</a>
    </section>
}
else
{
    <div class="cart-layout">
        <section class="cart-items" aria-label="Sản phẩm trong giỏ hàng">
            @foreach (var item in Model.Items)
            {
                var imageUrl = string.IsNullOrWhiteSpace(item.ImageUrl)
                    ? Url.Content("~/images/placeholders/product-placeholder.svg")
                    : item.ImageUrl;

                <article class="cart-item">
                    <div class="cart-item__media">
                        <img src="@imageUrl" alt="@item.ProductName" loading="lazy" />
                    </div>

                    <div class="cart-item__details">
                        <h2>@item.ProductName</h2>
                        <span class="cart-item__unit-price">@item.UnitPrice.ToString("N0", culture) ₫ / sản phẩm</span>
                        <span class="cart-item__stock">Tồn kho: @item.StockQuantity</span>

                        @if (item.CanUpdate)
                        {
                            <form class="cart-item__quantity-form"
                                  asp-controller="Cart"
                                  asp-action="Update"
                                  method="post"
                                  asp-antiforgery="true">
                                <input type="hidden" name="ProductId" value="@item.ProductId" />
                                <label for="quantity-@item.ProductId">Số lượng</label>
                                <input id="quantity-@item.ProductId"
                                       name="Quantity"
                                       type="number"
                                       value="@item.Quantity"
                                       min="1"
                                       max="@item.StockQuantity"
                                       inputmode="numeric" />
                                <button class="btn btn-outline-primary" type="submit">Cập nhật</button>
                            </form>
                        }
                        else
                        {
                            <p class="cart-item__unavailable">Sản phẩm hiện không khả dụng để cập nhật số lượng.</p>
                        }
                    </div>

                    <div class="cart-item__actions">
                        <strong class="cart-item__line-total">@item.LineTotal.ToString("N0", culture) ₫</strong>
                        <form asp-controller="Cart"
                              asp-action="Remove"
                              method="post"
                              asp-antiforgery="true">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button class="cart-item__remove" type="submit" aria-label="Xóa @item.ProductName khỏi giỏ hàng">Xóa</button>
                        </form>
                    </div>
                </article>
            }
        </section>

        <aside class="cart-summary" aria-labelledby="cart-summary-title">
            <h2 id="cart-summary-title">Tổng kết</h2>
            <dl>
                <div>
                    <dt>Tổng số lượng</dt>
                    <dd>@Model.TotalItems</dd>
                </div>
                <div class="cart-summary__total">
                    <dt>Tổng tiền</dt>
                    <dd>@Model.TotalAmount.ToString("N0", culture) ₫</dd>
                </div>
            </dl>

            <button class="btn btn-primary cart-summary__checkout"
                    type="button"
                    disabled
                    title="Thanh toán sẽ được triển khai ở bước tiếp theo">
                Tiến hành thanh toán
            </button>
            <small>Chức năng thanh toán đang được phát triển.</small>

            <form asp-controller="Cart"
                  asp-action="Clear"
                  method="post"
                  asp-antiforgery="true">
                <button class="cart-summary__clear" type="submit">Xóa toàn bộ giỏ hàng</button>
            </form>
        </aside>
    </div>
}
