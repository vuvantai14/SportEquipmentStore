@model LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <section class="auth-card" aria-labelledby="login-title">
        <div class="auth-card__heading">
            <span class="auth-card__eyebrow">Tài khoản khách hàng</span>
            <h1 id="login-title">Đăng nhập</h1>
            <p>Đăng nhập bằng tên đăng nhập hoặc email của bạn.</p>
        </div>

        @if (TempData["AuthSuccess"] is string successMessage)
        {
            <div class="auth-alert auth-alert--success" role="status">@successMessage</div>
        }

        <form asp-controller="Account"
              asp-action="Login"
              method="post"
              asp-antiforgery="true"
              class="auth-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>

            <div class="auth-field">
                <label asp-for="Identifier"></label>
                <input asp-for="Identifier"
                       class="form-control"
                       autocomplete="username"
                       autofocus />
                <span asp-validation-for="Identifier"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password"></label>
                <input asp-for="Password"
                       class="form-control"
                       autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="form-check auth-remember">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button class="btn btn-primary auth-submit" type="submit">Đăng nhập</button>
        </form>

        <p class="auth-switch">
            Chưa có tài khoản?
            <a asp-controller="Account" asp-action="Register">Đăng ký</a>
        </p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
